{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:translations && tsc -b && vite build",
    "check:translations": "node scripts/check-arabic-source.mjs",
    "start": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "openapi-typescript ../docs/swagger.json -o src/api/generated.ts",
    "inventory:routes": "node scripts/route-inventory.mjs",
    "audit:api": "npm run inventory:routes && node scripts/api-integration-audit.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.4",
    "lucide-react": "^1.16.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
